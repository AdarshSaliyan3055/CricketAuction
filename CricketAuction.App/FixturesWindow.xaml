<Window x:Class="CricketAuction.App.FixturesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fixtures" Width="1280" Height="820" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}">
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="Ink" Color="#253346"/>
        <SolidColorBrush x:Key="Muted" Color="#68778A"/>
        <SolidColorBrush x:Key="Line" Color="#DDE3EA"/>
        <SolidColorBrush x:Key="Input" Color="#F7F9FB"/>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemBorder" Background="White" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EDF3F8"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E3EEF7"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ClassicCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="9,4"/>
            <Setter Property="Foreground" Value="#253346"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCD5DF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" Background="White" BorderBrush="#CCD5DF" BorderThickness="1" CornerRadius="4">
                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#68778A" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#7998B5"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="9,3,28,3" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="White" BorderBrush="#CCD5DF" BorderThickness="1" CornerRadius="4" Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="#477DAA"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FixtureText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <DataTemplate x:Key="StatusOption">
            <TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding}"/>
                <Style.Triggers><DataTrigger Binding="{Binding}" Value="InProgress"><Setter Property="Text" Value="In progress"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style></TextBlock>
        </DataTemplate>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F4F7"/><Setter Property="Foreground" Value="#596A7D"/>
            <Setter Property="Padding" Value="10,12"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="FixtureRow" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Input}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF3EF"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FixtureCell" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF3EF"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="FixtureInlineCombo" TargetType="ComboBox" BasedOn="{StaticResource ClassicCombo}">
            <Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FixtureStatusBadge" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource Input}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Double-click to change match status"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Fixture.Status}" Value="InProgress"><Setter Property="Background" Value="#E4F3F8"/></DataTrigger>
                <DataTrigger Binding="{Binding Fixture.Status}" Value="Completed"><Setter Property="Background" Value="#EAF3EF"/><Setter Property="Cursor" Value="Arrow"/><Setter Property="ToolTip" Value="Completed status is locked"/></DataTrigger>
                <DataTrigger Binding="{Binding Fixture.Status}" Value="Abandoned"><Setter Property="Background" Value="#FFF1D8"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FixtureStatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Fixture.Status}" Value="InProgress"><Setter Property="Foreground" Value="#287D97"/></DataTrigger>
                <DataTrigger Binding="{Binding Fixture.Status}" Value="Completed"><Setter Property="Foreground" Value="#157952"/></DataTrigger>
                <DataTrigger Binding="{Binding Fixture.Status}" Value="Abandoned"><Setter Property="Foreground" Value="#A65A00"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FixtureWinnerText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><DataTrigger Binding="{Binding Fixture.Status}" Value="Completed"><Setter Property="Foreground" Value="#157952"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="28,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="TOURNAMENT WORKSPACE  /  MATCHES" Foreground="#159963" FontSize="10" FontWeight="Bold"/><TextBlock Text="Fixtures" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding TournamentName}" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="Home" Click="GoHome" VerticalAlignment="Center" Padding="14,8" Margin="12,0,0,0"/>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="13,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="TOTAL MATCHES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="13,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="UPCOMING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding UpcomingCount}" FontSize="22" FontWeight="SemiBold" Foreground="#157952"/></StackPanel></Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="13,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="IN PROGRESS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding LiveCount}" FontSize="22" FontWeight="SemiBold" Foreground="#398DA7"/></StackPanel></Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="13,10"><StackPanel><TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding CompletedCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
        </UniformGrid>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <WrapPanel>
                <Button Content="Generate schedule" Click="GenerateSchedule" Background="#157952" Foreground="White" BorderThickness="0" Padding="13,8"/>
                <Button Content="Add match" Click="AddFixture" Padding="13,8"/>
                <Button Content="Delete" Click="DeleteFixture" Padding="13,8" IsEnabled="{Binding CanDelete}"/>
                <Button Content="Export CSV" Click="ExportCsv" Padding="13,8"/>
                <Button Content="Print / PDF" Click="PrintSchedule" Padding="13,8" ToolTip="Print the full schedule; choose Microsoft Print to PDF to save a PDF."/>
            </WrapPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Match schedule" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Double-click a status or winner to update the result." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Search matches" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Muted}"/><TextBox x:Name="SearchBox" Width="240" MinHeight="34" TextChanged="SearchChanged" ToolTip="Search teams, stages, grounds or results" AutomationProperties.Name="Search fixtures"/></StackPanel>
            </Grid>
            <TextBlock Text="{Binding WarningSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="0">
            <Grid>
                <DataGrid x:Name="FixtureGrid" ItemsSource="{Binding VisibleFixtures}" SelectedItem="{Binding SelectedFixture}" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F4" RowBackground="White" AlternatingRowBackground="#FAFBFC" CanUserResizeRows="False" RowHeight="58" BorderThickness="0" AlternationCount="2" RowStyle="{StaticResource FixtureRow}" CellStyle="{StaticResource FixtureCell}" BeginningEdit="FixtureGridBeginningEdit">
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource FixtureText}" Header="MATCH NO." Binding="{Binding MatchLabel}" SortMemberPath="MatchNumber" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn ElementStyle="{StaticResource FixtureText}" Header="STAGE" Binding="{Binding StageLabel}" Width="125" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="FIXTURE" Width="*" MinWidth="210" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Matchup}" FontWeight="SemiBold"/><TextBlock Text="{Binding QualificationLabel}" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource FixtureText}" Header="DATE &amp; TIME" Binding="{Binding DateLabel}" Width="155" IsReadOnly="True"/>
                        <DataGridTextColumn ElementStyle="{StaticResource FixtureText}" Header="GROUND" Binding="{Binding Ground}" Width="120" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="STATUS" Width="125" IsReadOnly="False" CellStyle="{StaticResource FixtureCell}">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource FixtureStatusBadge}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource FixtureStatusText}" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox Style="{StaticResource FixtureInlineCombo}" ItemTemplate="{StaticResource StatusOption}" ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" SelectedItem="{Binding Fixture.Status, Mode=OneWay}" SelectionChanged="FixtureStatusChanged" IsEnabled="{Binding CanEditResult}" AutomationProperties.Name="Match status"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="WINNER" Width="150" IsReadOnly="False" CellStyle="{StaticResource FixtureCell}">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding WinnerLabel}" Style="{StaticResource FixtureWinnerText}" ToolTip="Double-click to choose or correct the winner"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox Style="{StaticResource FixtureInlineCombo}" ItemsSource="{Binding WinnerOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Fixture.WinnerTeamId, Mode=OneWay}" SelectionChanged="FixtureWinnerChanged" IsEnabled="{Binding CanChooseWinner}" ToolTip="Choose the match winner. Required to mark a match completed."/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource FixtureText}" Header="RESULT" Binding="{Binding ScoreSummary}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="WARNINGS" Width="160" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Warning}" ToolTip="{Binding Warning}" Foreground="#A65A00" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" MaxWidth="360" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding VisibleCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Text="Pool qualifiers and playoff teams update from recorded winners. Fixture data is saved with this tournament and included in its database backup." Foreground="{DynamicResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
