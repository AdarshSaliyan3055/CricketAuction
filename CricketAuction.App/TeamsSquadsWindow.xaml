<Window x:Class="CricketAuction.App.TeamsSquadsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Teams &amp; Squads" Width="1180" Height="780" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}">
    <Window.Resources>
        <Style x:Key="SquadCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DDF3E9"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SquadRow" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Input}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DDF3E9"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="28,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="TOURNAMENT WORKSPACE  /  SQUADS" Foreground="#159963" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="Teams &amp; Squads" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding TournamentName}" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Home" Click="GoHome" VerticalAlignment="Center" Padding="14,8" Margin="12,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TEAMS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="3,2,0,10"/>
                    <DataGrid x:Name="TeamGrid" ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False" RowHeight="44" BorderThickness="0" RowStyle="{StaticResource SquadRow}" CellStyle="{StaticResource SquadCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TEAM" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="SQUAD" Binding="{Binding PlayerCount}" Width="62"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTeam.Name, TargetNullValue=Select a team}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CaptainText}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding CompositionText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" MinWidth="175" HorizontalAlignment="Right">
                            <TextBlock Text="REMAINING PURSE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SelectedTeam.Remaining, TargetNullValue=—}" FontSize="23" FontWeight="SemiBold" Foreground="#157952" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SpendText}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            <ProgressBar Value="{Binding SelectedTeam.BudgetUsagePercent, Mode=OneWay}" Maximum="100" Height="5" Width="175" Margin="0,8,0,0" Foreground="#159963" Background="{DynamicResource Line}" Visibility="{Binding HasBudget, Converter={StaticResource Visible}}" ToolTip="Share of team budget spent"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="2,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                    <TextBlock Text="PURCHASED PLAYERS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding RosterCountText}" Foreground="{DynamicResource Muted}" Margin="12,0,18,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding RosterSearch, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" MinHeight="30" ToolTip="Search this squad by player, role or jersey" AutomationProperties.Name="Search squad players"/>
                </Grid>
                <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Grid>
                    <DataGrid ItemsSource="{Binding Roster}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False" RowHeight="40" BorderThickness="0" AlternationCount="2" RowStyle="{StaticResource SquadRow}" CellStyle="{StaticResource SquadCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Player" Binding="{Binding FullName}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding PlayerType}" Width="120"/>
                            <DataGridTextColumn Header="Batting" Binding="{Binding BattingStyle}" Width="115"/>
                            <DataGridTextColumn Header="Bowling" Binding="{Binding BowlingStyle}" Width="140"/>
                            <DataGridTextColumn Header="BOUGHT FOR" Binding="{Binding SoldPrice}" Width="105"/>
                            <DataGridTextColumn Header="JERSEY" Binding="{Binding Jersey}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No purchased players match this search." TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Roster.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Text="Captain is the team owner recorded in auction settings." Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
    </Grid>
</Window>
